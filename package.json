{
  "name": "cscodetunnel",
  "version": "0.1.10",
  "description": "ngrok-like CLI + local dashboard built on Cloudflare Tunnel",
  "license": "MIT",
  "author": "Agus Prasetyo <agusprasetyo811@gmail.com>",
  "keywords": [
    "cloudflare",
    "tunnel",
    "cloudflared",
    "ngrok",
    "cli",
    "proxy",
    "localhost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agusprasetyo811/cscodetunnel.git"
  },
  "homepage": "https://github.com/agusprasetyo811/cscodetunnel#readme",
  "bugs": {
    "url": "https://github.com/agusprasetyo811/cscodetunnel/issues"
  },
  "bin": {
    "cscodetunnel": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/dashboard/web','dist/dashboard/web',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/manual-e2e.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "express": "^4.22.2",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
